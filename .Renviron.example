DROPBOX_REFRESH_TOKEN=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=

# Chave do CARTO para o mapa base (gratuita para uso academico: https://carto.com/basemaps/apikey).
# Sem ela, o mapa usa o OpenStreetMap.
CARTO_API_KEY=